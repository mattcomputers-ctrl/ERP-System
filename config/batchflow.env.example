# BatchFlow ERP Configuration
# Copy to /opt/batchflow/backend/.env and customize

APP_NAME=BatchFlow ERP
APP_VERSION=1.0.0
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://batchflow:YOUR_DB_PASSWORD@localhost:5432/batchflow_erp

# Security - CHANGE THIS IN PRODUCTION
SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost,https://your-domain.com

# QuickBooks Sync
QB_SYNC_ENABLED=false
QB_SYNC_INTERVAL_SECONDS=300

# File Storage
UPLOAD_DIR=/var/lib/batchflow/uploads
LOG_DIR=/var/log/batchflow
